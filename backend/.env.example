# Salin ke .env lalu isi. Di Railway/Render, isi variabel ini di dashboard.

# Port HTTP (Railway/Render mengisi otomatis).
PORT=8080

# Database: path file = SQLite (dev lokal); postgres://... = PostgreSQL.
DATABASE_URL=data/rumah.db
# DATABASE_URL=postgres://rumah:rumah@localhost:5432/rumah?sslmode=disable

# Rahasia JWT, minimal 32 karakter. Buat dengan: openssl rand -hex 32
JWT_SECRET=
JWT_TTL=72h

# Origin frontend yang boleh memanggil API, pisahkan dengan koma.
# Wildcard didukung, mis. https://web-personal-*.vercel.app untuk preview Vercel.
CORS_ORIGINS=http://localhost:5173

# Akun super_admin (pemilik), dibuat sekali saat server start jika belum ada.
OWNER_NAME=Trias Aji Lomanto
OWNER_EMAIL=
OWNER_PASSWORD=

# LLM lewat endpoint chat completions yang kompatibel dengan OpenAI.
# Kosongkan AI_BASE_URL/AI_MODEL untuk menonaktifkan fitur AI (sentimen tetap jalan).
# OpenAI    : AI_BASE_URL=https://api.openai.com/v1      AI_MODEL=gpt-4o-mini
# Anthropic : AI_BASE_URL=https://api.anthropic.com/v1   AI_MODEL=claude-haiku-5-5
# Ollama    : AI_BASE_URL=http://localhost:11434/v1      AI_MODEL=llama3.2  (AI_API_KEY boleh kosong)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
